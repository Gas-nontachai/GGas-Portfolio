{
  "name": "ggas-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "assets:check": "node scripts/optimize-images.mjs --dry-run",
    "assets:optimize": "node scripts/optimize-images.mjs --write",
    "assets:check:large": "node scripts/optimize-images.mjs --dry-run --resize-large",
    "assets:optimize:large": "node scripts/optimize-images.mjs --write --resize-large",
    "test:ending": "node --test tests/ending-motion.test.mjs",
    "test:assets": "node --test tests/optimize-images.test.mjs",
    "test:journey": "node --test tests/journey-motion.test.mjs tests/notebook-motion.test.mjs",
    "test:experiments": "node --test tests/experiment-selection.test.mjs tests/experiment-scroll.test.mjs tests/experiment-layout.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@risky2k1/neobrutalism-ui": "^0.1.0",
    "gsap": "^3.15.0",
    "i18next": "^26.4.4",
    "lucide-react": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
